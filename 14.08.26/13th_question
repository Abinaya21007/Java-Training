import java.util.*;
class bank {
    static String Bank_name="Mariamman Indian Bank";
    private Long acc_no;
    private String acc_holder_name;
    private String acc_type;
    private float balance;
    private Long mobile_number;
    static Scanner sc=new Scanner(System.in);
    bank(Long acc_no,String acc_type,float balance,String acc_holder_name,long mobile_number){
        this.acc_no=acc_no;
        this.balance=balance;
        this.acc_type=acc_type;
        this.acc_holder_name=acc_holder_name;
        this.mobile_number =mobile_number;
    }
    Long get_acc_no(){
        return acc_no;
    }
    String get_acc_holder_name(){
        return acc_holder_name;
    }
    Long get_mobile_number(){
        return mobile_number;
    }
    String get_acc_type(){
        return acc_type;
    }
    float get_balance(){
        return balance;
    }
    void set_mobilenumber(){
        System.out.println("enter your using mobile phone number");
        mobile_number=sc.nextLong();
        System.out.println("your edited mobile number is"+mobile_number);
    }
   void withdraw(){
    System.out.println("enter amt ");
    float amt=sc.nextFloat();
    if(amt<0){
        System.out.println("you have entered wrong amount");
    }
    else if(amt>balance){
        System.out.println("insufficient balance");
    }
    else{
        balance-=amt;
        System.out.println("your remaining balance is"+balance);
    }
   }
   void deposit(){
        System.out.println("enter amt ");
        float amt=sc.nextFloat();
        if(amt<0){
            System.out.println("invalid input");
        }
        else{
            balance+=amt;
            System.out.println("your current balance is "+balance);
        }
    }
    void display_detail(){
        System.out.println("bank name : "+Bank_name);
        System.out.println("Account holder name "+get_acc_holder_name());
        System.out.println("Account number "+get_acc_no());
        System.out.println("Account type " +get_acc_type());
        System.out.println("Balance "+get_balance());
        System.out.println("Mobile number "+get_mobile_number());
    }
}
class second_java{
    public static void main(String args[]){
        bank b=new bank((long)7412365,"Savings account",754.0f,"abinaya",(long)789654321);
        b.display_detail();
        b.set_mobilenumber();
        b.deposit();
        b.withdraw();
        b.display_detail();
    }   
}
