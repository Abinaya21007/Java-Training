import java.util.*;
class customer {
    private Long acc_no;
    private String acc_holder_name;
    private String acc_type;
    private float balance;
    static Scanner sc=new Scanner(System.in);
    customer(Long acc_no,String acc_type,float balance,String acc_holder_name){
        this.acc_no=acc_no;
        this.balance=balance;
        this.acc_type=acc_type;
        this.acc_holder_name=acc_holder_name;
    }   
    
     Long get_acc_no(){
        return acc_no;
    }
    String get_acc_holder_name(){
        return acc_holder_name;
    }
    String get_account_type(){
        return acc_type;
    }
    float get_balance(){
        return balance;
    }
    void deposit(){
        System.out.println("enter the deposited amount");
        float amt=sc.nextFloat();
        if(amt>=0){
             balance+=amt;
             System.out.println("your current balance "+balance);
        }
        else{
            System.out.println("Invalid deposit amount ");
        }
    }
}
class second_java{
    public static void main(String args[]){
        customer customer1=new customer((long)92852631,"Savings Account",5000f,"Abinaya");
        System.out.println("Account holder name "+customer1.get_acc_holder_name());
        System.out.println("Account number "+customer1.get_acc_no());
        System.out.println("Account type " +customer1.get_account_type());
        System.out.println("Balance "+customer1.get_balance());
        customer1.deposit();
    }   
}