class customer {
    private Long acc_no;
    private String acc_holder_name;
    private Long mobile_number;
    private String account_type;
    private float balance;
    customer(Long acc_no,String acc_holder_name,Long mobile_number,String acc_type,float balance){
        this.acc_no=acc_no;
        this.acc_holder_name=acc_holder_name;
        this.mobile_number=mobile_number;
        this.balance=balance;
        this.acc_no=acc_no;
    }   
     Long get_acc_no(){
        return acc_no;
    }
    String get_acc_holder_name(){
        return acc_holder_name;
    }
    Long get_mobile_number(){
        return mobile_number;
    }
    String get_account_type(){
        return account_type;
    }
    float get_balance(){
        return balance;
    }
}
class second_java{
    public static void main(String args[]){
        customer customer1=new customer((long)92852631,"abii",(long)1236547890,"Savings Account",5000f);
        System.out.println("Account holder name "+customer1.get_acc_holder_name());
        System.out.println("Account number "+customer1.get_acc_no());
        System.out.println("Account type " +customer1.get_account_type());
        System.out.println("Balance "+customer1.get_balance());
        System.out.println("Mobile number "+customer1.get_mobile_number());
    }
}