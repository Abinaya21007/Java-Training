import java.util.*;
abstract class employee{
    private int id;
    private String name;
    private float bsalary;
    abstract void calculatesalary();
    void set_details(int id,String name, float bsalary){
        this.id=id;
        this.name=name;
        this.bsalary=bsalary;
    }
    int get_id(){
        return id;
    }
    String get_name(){
        return name;
    }
    float get_bsalary(){
        return bsalary;
    }
    void display(){
        System.out.println("empl id "+id);
        System.out.println("Emp name: "+name);
        System.out.println("Employee basic salary "+bsalary);
    }
}
class doctor extends employee{
    float tsalary;
    @Override
    void calculatesalary(){
        float sal= get_bsalary();
        float allowance=0.50f;
        tsalary=sal+(sal*allowance);
    }
    @Override
    void display(){
        System.out.println("empl id "+get_id());
        System.out.println("Emp name: "+get_name());
        System.out.println("Employee basic salary "+get_bsalary());
        System.out.println("Total salary "+tsalary);
    }
}
class nurse extends employee{
    float tsalary;
    @Override
    void calculatesalary(){
        float sal= get_bsalary();
        float allowance=0.10f;
        tsalary=sal+(sal*allowance);
    }
    @Override
    void display(){
        System.out.println("empl id "+get_id());
        System.out.println("Emp name: "+get_name());
        System.out.println("Employee basic salary "+get_bsalary());
        System.out.println("Total salary "+tsalary);
    }
}class lab_tech extends employee{
    float tsalary;
    @Override
    void calculatesalary(){
        float sal= get_bsalary();
        float allowance=0.05f;
        tsalary=sal+(sal*allowance);
    }
    @Override
    void display(){
        System.out.println("empl id "+get_id());
        System.out.println("Emp name: "+get_name());
        System.out.println("Employee basic salary "+get_bsalary());
        System.out.println("Total salary "+tsalary);
    }
}
class second_java{
    public static void main(String args[]){
        doctor d=new doctor();
        nurse n=new nurse();
        lab_tech l=new lab_tech();
        employee e[]={d,n,l};
        Scanner sc=new Scanner(System.in);
        int a ;
        String b;
        float c;
        for (int i = 0; i < 3; i++) {
            a=sc.nextInt();
            sc.nextLine();
            b=sc.nextLine();
            c=sc.nextFloat();
            e[i].set_details(a, b, c);
            e[i].get_name();
            e[i].get_id();
            e[i].get_bsalary();
            e[i].calculatesalary();
            e[i].display();
        }
    }
}

import java.util.*;
abstract class bank{
    int accno;
    String holdername;
    int bal;
    void get_details(){
        Scanner sc=new Scanner(System.in);
        System.out.println("enter the account number");
        accno=sc.nextInt();
        sc.nextLine();
        System.out.println("enter the account holder's name");
        holdername=sc.nextLine();
        System.out.println("enter the account balance");
        bal=sc.nextInt();
    }
    abstract void withdraw();
    void deposit(int amt){
        bal+=amt;
        System.out.println("amt deposited "+bal);
    }
    void display_details(){
        System.out.println("account number "+accno);
        System.out.println("holder  name "+holdername);
        System.out.println("current balance "+bal);
    }
}
class savings extends bank{
    @Override
    void withdraw(){
        int amt;
        Scanner sc=new Scanner(System.in);
        amt=sc.nextInt();
        int d=bal-1000;
        if(d >amt){
            System.out.println("your balance is" +(bal-amt));
        }
        else{
            System.out.println("you don't have enough balance");
        }
    }
}
class current extends bank{
    @Override
    void withdraw(){
        int amt;
        Scanner sc=new Scanner(System.in);
        amt=sc.nextInt();
        int d=5000;
        if(d <amt && bal>amt){
            System.out.println("your balance is" +(bal -amt));
        }
        else{
            System.out.println("you dont have enough balance");
        }
    }
}
class second_java{
    public static void main(String args[]){
        savings s=new savings();
        current c=new current();
        s.get_details();
        s.display_details();
        s.deposit(5000);
        s.withdraw();
        c.get_details();
        c.display_details();
        c.deposit(1500);
        c.withdraw();
    }
}


import java.util.*;
abstract class BankAccount {
    protected int accountNumber;
    protected String holderName;
    protected double balance;
    protected int pin;
    BankAccount(int accountNumber, String holderName,
                double balance, int pin) {
        this.accountNumber = accountNumber;
        this.holderName = holderName;
        this.balance = balance;
        this.pin = pin;
    }
    boolean verifyPin(int p) {
        return pin == p;
    }
    void deposit(double amt) {
        balance += amt;
        System.out.println("Amount Deposited: ₹" + amt);
    }
    abstract void withdraw(double amt);
    void checkBalance() {
        System.out.println("Balance: ₹" + balance);
    }
    void displayDetails() {
        System.out.println("Account Number : " + accountNumber);
        System.out.println("Holder Name    : " + holderName);
        System.out.println("Balance        : ₹" + balance);
    }
}
class SavingsAccount extends BankAccount {
    SavingsAccount(int accNo, String name,
                   double bal, int pin) {
        super(accNo, name, bal, pin);
    }
    @Override
    void withdraw(double amt) {
        if ((balance - amt) >= 1000) {
            balance -= amt;
            System.out.println("₹" + amt + " Withdrawn");
        } else {
            System.out.println("Minimum balance ₹1000 must be maintained");
        }
    }
}
class CurrentAccount extends BankAccount {
    double overdraftLimit = 5000;
    CurrentAccount(int accNo, String name,
                   double bal, int pin) {
        super(accNo, name, bal, pin);
    }
    @Override
    void withdraw(double amt) {
        if ((balance + overdraftLimit) >= amt) {
            balance -= amt;
            System.out.println("₹" + amt + " Withdrawn");
        } else {
            System.out.println("Overdraft limit exceeded");
        }
    }
}
class ATM {
    int atmId;
    String location;
    ATM(int id, String loc) {
        atmId = id;
        location = loc;
    }
    void start(BankAccount acc) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter Account Number: ");
        int ac = sc.nextInt();
        System.out.print("Enter PIN: ");
        int p = sc.nextInt();
        if (ac == acc.accountNumber && acc.verifyPin(p)) {

            System.out.println("Login Successful!");

            int choice;

            do {
                System.out.println("\n1.Check Balance");
                System.out.println("2.Withdraw");
                System.out.println("3.Deposit");
                System.out.println("4.Account Details");
                System.out.println("5.Exit");

                System.out.print("Enter Choice: ");
                choice = sc.nextInt();

                switch (choice) {

                    case 1:
                        acc.checkBalance();
                        break;

                    case 2:
                        System.out.print("Enter Amount: ");
                        double w = sc.nextDouble();
                        acc.withdraw(w);
                        break;

                    case 3:
                        System.out.print("Enter Amount: ");
                        double d = sc.nextDouble();
                        acc.deposit(d);
                        break;

                    case 4:
                        acc.displayDetails();
                        break;

                    case 5:
                        System.out.println("Thank You!");
                        break;

                    default:
                        System.out.println("Invalid Choice");
                }

            } while (choice != 5);

        } else {
            System.out.println("Invalid Account Number or PIN");
        }
    }
}
public class second_java {
    public static void main(String[] args) {
        BankAccount acc =
            new SavingsAccount(1001, "Abi", 30000, 1234);
        ATM atm = new ATM(1, "Chennai");

        atm.start(acc);
    }
}
